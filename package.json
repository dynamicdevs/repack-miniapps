{
  "name": "repack-miniapps",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && node --test scripts/*.test.mjs",
    "verify": "node scripts/verify-provider.mjs",
    "modules": "node scripts/sync-modules.mjs"
  },
  "dependencies": {
    "@dentvega/miniapp-storage": "workspace:*"
  }
}
